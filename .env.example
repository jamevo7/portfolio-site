# Contact form email delivery (optional).
# Without these set, the contact form still works but tells visitors to email
# you directly instead of sending an email.
#
# Get an API key at https://resend.com
RESEND_API_KEY=
# Where contact-form submissions are delivered:
CONTACT_TO_EMAIL=jamesvo2468@gmail.com
# The "from" address. Use Resend's sandbox until you verify a domain:
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Number of trusted reverse proxies in front of the app (used to derive the
# real client IP for rate limiting from X-Forwarded-For). Default: 1, which is
# correct for Vercel. Increase only if you add another proxy/CDN in front.
# TRUSTED_PROXY_HOPS=1
